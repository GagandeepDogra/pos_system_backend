# lan (counter PC, default) or cloud (VPS). See docs/deployment.md.
DEPLOY_PROFILE=lan
# Port and interface the API listens on. LAN profile: HOST must be a private LAN
# address (empty = this PC's LAN address); 0.0.0.0 and public addresses are refused.
PORT=3000
HOST=
# HTTPS certificate and key (PEM). Required in the cloud profile (Let's Encrypt
# fullchain.pem/privkey.pem); optional on the LAN (mkcert pos.local).
TLS_CERT_FILE=
TLS_KEY_FILE=
# With TLS: plain-HTTP port that only redirects to HTTPS (e.g. 80)
HTTP_REDIRECT_PORT=
# Cloud profile, required: the one https origin the browser app is served from
CORS_ORIGIN=
# Mounted folder on another machine for the nightly off-server backup copy
# (required in the cloud profile) and the IST time of the copy
OFFSITE_BACKUP_DIR=
OFFSITE_BACKUP_TIME=02:30
# Folder that holds the live workbook (dhaba-pos.xlsx) and the lock file
DATA_DIR=./data
# Password that protects the workbook's sheets against casual hand edits
WORKBOOK_SHEET_PASSWORD=change-me
# Optional IST open hours (HH:mm-HH:mm, may run past midnight) for the automatic
# 15-minute snapshots into backups/. Leave empty to snapshot at any hour.
SNAPSHOT_OPEN_HOURS=

# Login token signing secret (32+ chars). Empty = read JWT_SECRET_FILE (default:
# pos-api-jwt.secret next to DATA_DIR, generated on first start). Never inside DATA_DIR.
JWT_SECRET=
JWT_SECRET_FILE=

# Optional folder with the web app static build (index.html at its root), served on non-API paths
WEB_DIR=
